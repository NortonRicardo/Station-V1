# Copie para .env (o .env fica fora do git).
# Senha da gravação pelo Wi-Fi (OTA), mínimo 8 caracteres. A rede própria Station-XXXX é aberta.
STATION_OTA_PASS=troque-esta-senha

# Envio para o climora-ingest: a mesma STATION_KEY do Environment do ingest no Dokploy.
# Sem ela, a estação grava no SD mas não envia.
STATION_KEY=
# Opcional (padrão: https://ingest.climora.tech/api/v1/ingest)
# STATION_INGEST_URL=https://ingest.climora.tech/api/v1/ingest
